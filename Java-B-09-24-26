import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);
        System.out.println("Hello, World");

        // DATA TYPES 
        // int - whole number 
        // double - double precision of decimal number 
        // float - single precision of decimal number 'f' 
        // char - a single character of text (single quotes) 
        // String - not primitive text (double quotes)
        // boolean - true or false (primitive type is lowercase 'boolean') 

        // Declaring variables of different data types 
        int age = 20; 
        double weight = 20.30; 
        float deep = 70.6f; 
        char grade = 'A'; 
        String name = "Genard"; 
        boolean isStudent = true; 

        
        System.out.println("Age: " + age); 
        System.out.println("Weight: " + weight); 
        System.out.println("Deep: " + deep); 
        System.out.println("Grade: " + grade); 
        System.out.println("Name: " + name); 
        System.out.println("Am I beautiful: " + isStudent); 
    
 
        // Getting input using Scanner

        System.out.println("Enter your address:");
        String userAddress = scanner.next();// read one words
        System.out.println("Where is your address? " + userAddress);

        // Reading the full line (including spaces)
        scanner.nextLine();// clears leftover newline from previous next()
        System.out.println("Enter a sentence about yourself:");
        String fullSentence = scanner.nextLine();//reads the entire line or paragraph
        System.out.println("You said: " + fullSentence);
       

        // operator and expression
        // =,-,*,&&, ||, >,<, <=,>=,!=
        int a = 10, b = 3;
        System.out.println("a + b = " + (a+b)); 
        System.out.println("a - b = " + (a-b));
        System.out.println("a * b = " + (a*b)); 
        System.out.println("a / b = " + (a/b)); 
        System.out.println("a % b = " + (a%b)); 

        double x = 10, y = 3;
        System.out.println("x / y " + (x/y)); 

        // Relational Operator (returm bool: 1 or 0)
        System.out.println("a == b = " + (a==b)); 
        System.out.println("a != b = " + (a!=b));
        System.out.println("a <= b = " + (a<=b)); 
        System.out.println("a >= b = " + (a>=b)); 
        System.out.println("a > b = " + (a>b)); 
        System.out.println("a < b = " + (a<b)); 

        // Logical Operators
        boolean p = true, q = false;
        System.out.println("p && q = " + (p&&q)); // And
        System.out.println("p || q = " + (p||q));  // Or
        System.out.println("!p " + (!p)); // Not
        System.out.println("!q " + (!q)); //Not

        // assignment operator 
        // +=, -=, *=, /=, 
        int score = 50; 
        score += 10; 
        System.out.println("Score after += " + score); 

        score *= 2; 
        System.out.println("Score after *= " + score);

        // Increment / Decrement Operators
        int counter = 5;
        System.out.println("Counter ++ (post): "+ counter++);
        System.out.println("Counter  now ++ "+ counter++);
        System.out.println("++Counter(pre): "+ ++counter);

        //Control Flow ( if, else, switch case, loop (for, while, do while))
        System.out.println("Enter your exam:");
        int Examscore = scanner.nextInt();

        if (Examscore >= 90) {
            System.out.println("Grade: Magaling");
        }
        else if (Examscore >= 80 ) {
            System.out.println("Grade: Chamba");
        }
        else if (Examscore >= 70 ) {
            System.out.println("Grade: Malangis");
        }
        else {
            System.out.println("Grade: Mabaling");
        }

        // Switch Case Statement 
        System.out.print("Enter a day number (1-7)"); 
        int day = scanner.nextInt(); 
        switch (day) { 
            case 1: System.out.println("Monday"); break; 
            case 2: System.out.println("Tuesday"); break; 
            case 3: System.out.println("Wednesday"); break; 
            case 4: System.out.println("Thursday"); break; 
            case 5: System.out.println("Friday"); break; 
            case 6: System.out.println("Saturday"); break; 
            case 7: System.out.println("Sunday"); break; 
            default: System.out.println("Invalid day"); break; 
        } 

        //loops (for, while, do while) 
        System.out.println("Counting 1 to 5 with a for loop:"); 
        for(int i = 1; i <= 5; i++){ 
            System.out.print(i + ""); 
        } 
        System.out.println(); 

        System.out.println("\nCounting down from 5 with a while loop:");
        int n = 5;
        while (n > 0) {
            System.out.print(n + " ");
            n--;
        }
        System.out.println(); 

        // do while loops
        System.out.println("do-while example:");
        int doWhileX = 0;
        do {
            System.out.println("x=" + doWhileX);
            doWhileX++;
        } while (doWhileX < 3);

        // break and continue
        System.out.println("skipping 3 usinf continue, stopping at 7 using breaK:");
        for(int i = 1; i <= 10; i++){
            if (i == 3) continue;
            if (i == 7) break;
            System.out.println(i + "");
        }
        System.out.println();
        
        // calling functions 
        int sum = add (5,7);
        System.out.println("5 + 7 = " + sum);

        // squareroot\
        double sq = square (4.5);
        System.out.println("4.5 square = "+ sq);

        greet("Maria");

        System.out.println("5! = " + factorial (5));

        System.out.println("multiply(2,3)= "+ multiply(2, 3));
        System.out.println("multiply(2.5,4.0)= "+ multiply(2.5,4.0));

        System.out.println("power (5)="+power(5));
        System.out.println("power (5,3)="+power(5,3));

        
    }

    //Methods
    //TAkes a double, return its square 
    static double square(double n){
        return n * n;
    }
    
    //Takes two ints, returns their sum 
    static int add(int a, int b){
        return a + b;
    }
    
    //void function: performs an action, return nothing 
    static void greet(String name){
        System.out.println("Hello," + name + " !Wlcome to JAva.");
    }
    
    //Recursive function
    static int factorial(int n){
        if (n <= 1){
            return 1;
        }
        return n * factorial(n - 1);
    }
    
    static int multiply(int a , int b){
        return a * b;
    }
    
    static double multiply(double a, double b){
        return a * b;
    }
    
    //power, exponent
    static int power(int base, int exponent){
        int result = 1;
        for (int i = 0; i < exponent; i++){
            result *= base;
        }
        return result;
    }

    // base
static int power (int base){
    return power (base,2);
    }

// calling functions 
int sum = add (5,7);
    System.out.println("5 + 7 = " + sum);

// squareroot\
double sq = square (4.5);
System.out.println("4.5 square = "+ sq);

greet("Maria");

System.out.println("5! = " + factorial (5));

System.out.println("multiply(2,3)= "+ multiply(2, 3));
System.out.println("multiply(2.5,4.0)= "+ multiply(2.5,4.0));

System.out.println("power (5)="+power(5));
System.out.println("power (5,3)="+power(5,3));

scanner.close();

    }
}

   
